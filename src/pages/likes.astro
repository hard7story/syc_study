---
import Layout from '../layouts/Layout.astro';
import { baseUrl as base, SOURCE_META } from '../lib/data.ts';

// 좋아요 상태는 브라우저(localStorage)에만 있으므로 목록은 클라이언트에서 렌더링한다.
// 전체 기사 인덱스(articles.json)를 받아 좋아요한 것만 날짜별로 묶어 보여준다.
const sourceMeta = SOURCE_META;
---

<Layout title="좋아요 — 데일리 테크 브리핑">
  <div class="mb-4 flex items-baseline justify-between">
    <h1 class="text-xl font-bold">♥ 좋아요</h1>
    <span id="likes-total" class="text-xs text-slate-400"></span>
  </div>

  <div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
    <button
      id="likes-export"
      type="button"
      class="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-600 hover:bg-slate-50"
    >
      내보내기 (JSON)
    </button>
    <label
      class="cursor-pointer rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-600 hover:bg-slate-50"
    >
      가져오기
      <input id="likes-import" type="file" accept="application/json,.json" class="hidden" />
    </label>
    <span class="text-slate-400">좋아요는 이 브라우저에만 저장됩니다. 다른 기기와는 내보내기/가져오기로 옮기세요.</span>
  </div>

  <div id="likes-status" class="py-20 text-center text-slate-500">불러오는 중…</div>
  <div id="likes-list" class="flex flex-col gap-6"></div>
</Layout>

<script is:inline define:vars={{ base, sourceMeta }}>
  window.__LIKES_PAGE__ = { base, sourceMeta };
</script>

<script>
  import {
    readLikes,
    removeLike,
    exportLikes,
    importLikes,
    LIKES_CHANGED_EVENT,
    type LikeEntry,
  } from '../lib/likes.ts';

  interface IndexedArticle {
    date: string;
    id: string;
    source: 'hn' | 'geeknews' | 'yozm' | 'reddit';
    title: string;
    url: string;
    externalUrl?: string;
    commentsUrl?: string;
    score?: number;
    comments?: number;
    oneLineKo: string;
    summaryKo: string;
    tags?: string[];
  }

  const { base, sourceMeta } = (window as any).__LIKES_PAGE__ as {
    base: string;
    sourceMeta: Record<string, { label: string; badgeClass: string }>;
  };

  const statusEl = document.getElementById('likes-status')!;
  const listEl = document.getElementById('likes-list')!;
  const totalEl = document.getElementById('likes-total')!;

  let index: Map<string, IndexedArticle> | null = null;

  const ESC: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ESC[c]);
  }

  function formatDateKo(date: string): string {
    const [y, m, d] = date.split('-').map(Number);
    const weekday = ['일', '월', '화', '수', '목', '금', '토'][new Date(y, m - 1, d).getDay()];
    return `${y}년 ${m}월 ${d}일 (${weekday})`;
  }

  function cardHtml(key: string, a: IndexedArticle): string {
    const meta = sourceMeta[a.source] ?? { label: a.source, badgeClass: 'bg-slate-100 text-slate-600' };
    const originalUrl = a.externalUrl ?? a.url;
    const tags = (a.tags ?? [])
      .map((t) => `<span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-500">#${esc(t)}</span>`)
      .join('');
    const discussLabel = a.source === 'geeknews' ? 'GN 토론' : '토론';
    const discussCount = a.comments !== undefined ? ` (${a.comments})` : '';
    const discuss =
      a.commentsUrl && a.commentsUrl !== originalUrl
        ? `<a href="${esc(a.commentsUrl)}" target="_blank" rel="noopener noreferrer" class="hover:underline">${discussLabel}${discussCount}</a>`
        : '';
    return `
<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" data-like-key="${esc(key)}">
  <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
    <span class="rounded-full px-2 py-0.5 font-medium ${meta.badgeClass}">${esc(meta.label)}</span>
    ${a.score !== undefined ? `<span class="text-slate-400">▲ ${a.score}</span>` : ''}
    ${tags}
  </div>
  <h2 class="text-base font-semibold leading-snug">
    <a href="${esc(originalUrl)}" target="_blank" rel="noopener noreferrer" class="hover:underline">${esc(a.oneLineKo)}</a>
  </h2>
  <p class="mt-0.5 text-xs text-slate-400" title="${esc(a.title)}">${esc(a.title)}</p>
  <p class="mt-2 text-sm leading-relaxed text-slate-700">${esc(a.summaryKo)}</p>
  <div class="mt-3 flex items-center gap-3 text-xs text-slate-500">
    <a href="${esc(originalUrl)}" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline">원문 보기 →</a>
    ${discuss}
    <button type="button" class="unlike-btn ml-auto inline-flex items-center gap-1 rounded-full border border-rose-300 bg-rose-50 px-2 py-0.5 text-rose-600 hover:bg-rose-100" title="좋아요 취소">♥ 취소</button>
  </div>
</article>`;
  }

  function missingHtml(key: string, e: LikeEntry): string {
    return `
<article class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-500" data-like-key="${esc(key)}">
  <p>기사 데이터를 찾을 수 없습니다 (${esc(e.date)}).</p>
  <p class="mt-1 break-all text-xs text-slate-400">${esc(e.id)}</p>
  <button type="button" class="unlike-btn mt-2 rounded-full border border-slate-200 bg-white px-2 py-0.5 text-xs hover:bg-slate-100">목록에서 제거</button>
</article>`;
  }

  function render() {
    if (!index) return;
    const likes = readLikes();
    const entries = Object.entries(likes).sort(([, a], [, b]) => b.likedAt.localeCompare(a.likedAt));
    totalEl.textContent = entries.length > 0 ? `${entries.length}건` : '';

    if (entries.length === 0) {
      listEl.innerHTML = '';
      statusEl.innerHTML = `
        <p class="text-4xl">♡</p>
        <p class="mt-4">아직 좋아요한 기사가 없습니다.</p>
        <p class="mt-1 text-sm">기사 카드의 <span class="rounded-full border border-slate-200 px-2 py-0.5 text-xs">♡ 좋아요</span> 버튼을 눌러 모아두세요.</p>
        <p class="mt-4 text-sm"><a href="${base}" class="text-blue-600 hover:underline">오늘 브리핑 보기 →</a></p>`;
      statusEl.hidden = false;
      return;
    }
    statusEl.hidden = true;

    // 브리핑 날짜별 그룹 (최신 날짜 우선), 그룹 안에서는 좋아요 누른 순
    const groups = new Map<string, string[]>();
    for (const [key, entry] of entries) {
      const article = index.get(key);
      const html = article ? cardHtml(key, article) : missingHtml(key, entry);
      const list = groups.get(entry.date) ?? [];
      list.push(html);
      groups.set(entry.date, list);
    }
    const dates = [...groups.keys()].sort((a, b) => b.localeCompare(a));
    listEl.innerHTML = dates
      .map(
        (date) => `
<section>
  <div class="mb-2 flex items-baseline justify-between">
    <h2 class="text-sm font-semibold text-slate-600">${formatDateKo(date)}</h2>
    <a href="${base}archive/${date}/" class="text-xs text-slate-400 hover:underline">그날 브리핑 →</a>
  </div>
  <div class="flex flex-col gap-3">${groups.get(date)!.join('')}</div>
</section>`,
      )
      .join('');
  }

  listEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.unlike-btn');
    if (!btn) return;
    const key = btn.closest<HTMLElement>('[data-like-key]')?.dataset.likeKey;
    if (key) removeLike(key);
  });

  window.addEventListener(LIKES_CHANGED_EVENT, render);
  window.addEventListener('storage', render);

  document.getElementById('likes-export')!.addEventListener('click', () => {
    const blob = new Blob([exportLikes()], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `syc_study-likes-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('likes-import')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      const added = importLikes(await file.text());
      totalEl.textContent = `${added}건 추가됨`;
      setTimeout(render, 1200);
    } catch (err) {
      statusEl.textContent = `가져오기 실패: ${(err as Error).message}`;
      statusEl.hidden = false;
    } finally {
      input.value = '';
    }
  });

  (async () => {
    try {
      const res = await fetch(`${base}articles.json`, { cache: 'no-cache' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as { articles: IndexedArticle[] };
      index = new Map(data.articles.map((a) => [`${a.date}:${a.id}`, a]));
      render();
    } catch (err) {
      statusEl.textContent = `기사 목록을 불러오지 못했습니다: ${(err as Error).message}`;
    }
  })();
</script>
