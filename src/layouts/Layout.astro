---
import '../styles/global.css';
import { baseUrl } from '../lib/data.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '데일리 테크 브리핑',
  description = 'GeekNews, 요즘IT, Hacker News, Reddit의 IT 소식을 매일 아침 한국어로 요약해 전합니다.',
} = Astro.props;

const base = baseUrl;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-2xl items-center justify-between px-4 py-3">
        <a href={base} class="text-lg font-bold tracking-tight">
          📰 데일리 테크 브리핑
        </a>
        <nav class="flex gap-4 text-sm text-slate-600">
          <a href={`${base}archive/`} class="hover:text-slate-900">아카이브</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-2xl px-4 py-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-2xl px-4 py-8 text-center text-xs text-slate-400">
      매일 아침 자동 수집·요약됩니다 · 원문 저작권은 각 출처에 있습니다
    </footer>
  </body>
</html>
