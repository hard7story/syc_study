---
import { SOURCE_META, type SummarizedArticle } from '../lib/data.ts';

interface Props {
  article: SummarizedArticle;
}

const { article } = Astro.props;
const meta = SOURCE_META[article.source];
---

<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
    <span class={`rounded-full px-2 py-0.5 font-medium ${meta.badgeClass}`}>{meta.label}</span>
    {article.score !== undefined && (
      <span class="text-slate-400">▲ {article.score}</span>
    )}
    {article.tags?.map((tag) => (
      <span class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-500">#{tag}</span>
    ))}
  </div>

  <h2 class="text-base font-semibold leading-snug">
    <a href={article.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
      {article.oneLineKo}
    </a>
  </h2>
  <p class="mt-0.5 text-xs text-slate-400" title={article.title}>{article.title}</p>

  <p class="mt-2 text-sm leading-relaxed text-slate-700">{article.summaryKo}</p>

  <div class="mt-3 flex gap-3 text-xs text-slate-500">
    <a href={article.url} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline">
      원문 보기 →
    </a>
    {article.commentsUrl && article.commentsUrl !== article.url && (
      <a href={article.commentsUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
        토론 {article.comments !== undefined ? `(${article.comments})` : ''}
      </a>
    )}
  </div>
</article>
